{
  "name": "stand-grade",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "STAND GRADE — прототип сайта открытия кейсов Standoff 2",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server.js",
    "preview": "vite preview",
    "sync:standoffcraft": "node scripts/sync-standoffcraft.mjs",
    "sync:cs2": "node scripts/sync-cs2.mjs",
    "db:import": "node scripts/migrate-store-to-postgres.mjs",
    "db:copy": "node scripts/copy-postgres.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.14"
  }
}
