# Порт. Хостинг (Render/Vercel) передаёт свой через PORT, локально — 3001.
PORT=3001

# Обязательно на проде: секрет подписи токенов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-long-random-hex

# Где хранить store.json и session.secret.
# На Render с постоянным диском: /var/data. Локально можно не задавать.
# DATA_DIR=/var/data

# Сколько прокси-хопов доверять при определении IP (по умолчанию 1 для Render).
# TRUST_PROXY=1

# Rate limit: операций в минуту с одного IP.
# RATE_LIMIT_API_PER_MIN=180
# RATE_LIMIT_AUTH_PER_MIN=10
# RATE_LIMIT_REGISTER_PER_MIN=5
# RATE_LIMIT_ACTION_PER_MIN=60

# Максимальная сумма одной заявки на голду (по умолчанию 100000).
# MAX_GOLD_REQUEST=100000

# Глифы: целевой RTP режима и стартовый банк для покрытия дорогих заносов.
# GLYPH_TARGET_RTP=0.85
# GLYPH_BANK_START=10000

# Внешняя БД для сохранения аккаунтов между деплоями.
# Бесплатный Render не хранит файлы между деплоями, поэтому нужен Postgres
# (Supabase/Neon). Если не задан — используется store.json.
# Supabase: Project Settings → Database → Connection string → URI → Session pooler.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Разовый перенос состояния из старой базы в новую: npm run db:copy
# SOURCE_DATABASE_URL=postgresql://...render...
# TARGET_DATABASE_URL=postgresql://...supabase...

# Демо-аккаунт player по умолчанию отключён и не создаётся.
# Включать только локально: ENABLE_PLAYER_DEMO=true (пароль ниже).
# ENABLE_PLAYER_DEMO=false
# PLAYER_PASSWORD=player

# Anti-DDoS: автобан аккаунта при действиях с нескольких IP.
# SECURITY_WINDOW_MINUTES=10
# SECURITY_ACCOUNT_IP_LIMIT=4
# SECURITY_IP_VIOLATION_LIMIT=25
# SECURITY_IP_BLOCK_MINUTES=30

# Скрытый admin по умолчанию удалён. Вернуть: ENABLE_ADMIN_ACCOUNT=true
# ENABLE_ADMIN_ACCOUNT=false
# ADMIN_PASSWORD=rainy
# ADMIN_START_BALANCE=100000

# Владелец проекта: может создавать промокоды во вкладке «Промокоды».
# Задайте длинный пароль в Render. Если аккаунт уже создан, смена env его не обновит.
OWNER_PASSWORD=replace-with-strong-password
OWNER_START_BALANCE=500000

# Одноразовый сброс пароля owner. Задать в Render, задеплоить,
# войти, затем удалить переменную и задеплоить снова.
# OWNER_PASSWORD_RESET=replace-with-new-password
